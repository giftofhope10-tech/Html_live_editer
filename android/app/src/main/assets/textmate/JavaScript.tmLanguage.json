{
  "name": "JavaScript",
  "scopeName": "source.js",
  "fileTypes": ["js", "mjs", "cjs"],
  "patterns": [
    { "include": "#comment-line" },
    { "include": "#comment-block" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#string-template" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#storage" },
    { "include": "#constant" },
    { "include": "#function-call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment-line": {
      "name": "comment.line.double-slash.js",
      "match": "//.*$"
    },
    "comment-block": {
      "name": "comment.block.js",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "string-double": {
      "name": "string.quoted.double.js",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.js", "match": "\\\\." }]
    },
    "string-single": {
      "name": "string.quoted.single.js",
      "begin": "'",
      "end": "'",
      "patterns": [{ "name": "constant.character.escape.js", "match": "\\\\." }]
    },
    "string-template": {
      "name": "string.template.js",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "meta.template.expression.js",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [{ "include": "$self" }]
        },
        { "name": "constant.character.escape.js", "match": "\\\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.js",
      "match": "\\b(?:0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+|(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?)n?\\b"
    },
    "keyword": {
      "name": "keyword.control.js",
      "match": "\\b(?:break|case|catch|continue|debugger|default|delete|do|else|export|extends|finally|for|from|if|import|in|instanceof|new|of|return|super|switch|throw|try|typeof|void|while|with|yield|async|await)\\b"
    },
    "storage": {
      "name": "storage.type.js",
      "match": "\\b(?:class|const|enum|function|interface|let|var|type|abstract|declare|implements|namespace|module|package|private|protected|public|readonly|static)\\b"
    },
    "constant": {
      "name": "constant.language.js",
      "match": "\\b(?:true|false|null|undefined|NaN|Infinity|this|self|globalThis)\\b"
    },
    "function-call": {
      "name": "entity.name.function.js",
      "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*(?=\\()"
    },
    "operator": {
      "name": "keyword.operator.js",
      "match": "=>|===|!==|==|!=|<=|>=|\\?\\.|\\?\\.?|&&|\\|\\||\\+\\+|--|[+\\-*/%&|^~<>!?:=]"
    }
  }
}
