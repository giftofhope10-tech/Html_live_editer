{
  "name": "CSS",
  "scopeName": "source.css",
  "fileTypes": ["css"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#at-rule" },
    { "include": "#rule-set" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.css",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "at-rule": {
      "name": "keyword.control.at-rule.css",
      "match": "@[a-z-]+"
    },
    "rule-set": {
      "begin": "([^{/]+)\\{",
      "beginCaptures": { "1": { "name": "entity.name.tag.css" } },
      "end": "\\}",
      "patterns": [{ "include": "#declaration" }]
    },
    "declaration": {
      "patterns": [
        { "include": "#comment" },
        {
          "match": "([a-z][a-z0-9-]*)\\s*(:)",
          "captures": {
            "1": { "name": "support.type.property-name.css" },
            "2": { "name": "punctuation.separator.key-value.css" }
          }
        },
        {
          "name": "string.quoted.double.css",
          "begin": "\"", "end": "\""
        },
        {
          "name": "string.quoted.single.css",
          "begin": "'", "end": "'"
        },
        {
          "name": "constant.numeric.css",
          "match": "-?\\b(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|vh|vw|%|pt|cm|mm|ex|ch|vmin|vmax|fr|deg|rad|turn|s|ms)?\\b"
        },
        {
          "name": "constant.other.color.rgb.css",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        },
        {
          "name": "support.function.css",
          "match": "\\b(?:rgb|rgba|hsl|hsla|linear-gradient|radial-gradient|url|calc|var|env|min|max|clamp)\\s*(?=\\()"
        },
        {
          "name": "support.constant.property-value.css",
          "match": "\\b(?:auto|none|inherit|initial|unset|revert|normal|bold|italic|solid|dashed|dotted|flex|grid|block|inline|inline-block|inline-flex|inline-grid|absolute|relative|fixed|sticky|static|hidden|visible|scroll|overflow|center|left|right|top|bottom|middle|space-between|space-around|space-evenly|stretch|baseline|nowrap|wrap|column|row|transparent)\\b"
        }
      ]
    }
  }
}
