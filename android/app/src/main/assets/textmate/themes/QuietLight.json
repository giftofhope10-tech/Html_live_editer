{
  "name": "QuietLight",
  "type": "light",
  "colors": {
    "editor.background": "#f5f5f5",
    "editor.foreground": "#333333",
    "editorLineNumber.foreground": "#aaaaaa",
    "editor.lineHighlightBackground": "#e8f2ff",
    "editor.selectionBackground": "#c5d8f8"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "comment.block", "comment.line"],
      "settings": { "foreground": "#aaaaaa", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#448c27" }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": { "foreground": "#ab6526" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.operator"],
      "settings": { "foreground": "#4b83cd", "fontStyle": "bold" }
    },
    {
      "name": "Storage",
      "scope": "storage.type",
      "settings": { "foreground": "#4b83cd", "fontStyle": "bold" }
    },
    {
      "name": "Constant language",
      "scope": "constant.language",
      "settings": { "foreground": "#ab6526" }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": { "foreground": "#aa3731" }
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "settings": { "foreground": "#4b83cd" }
    },
    {
      "name": "Attribute name",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#91b3e0" }
    },
    {
      "name": "HTML Entity",
      "scope": "constant.character.entity",
      "settings": { "foreground": "#ab6526" }
    },
    {
      "name": "CSS property",
      "scope": "support.type.property-name",
      "settings": { "foreground": "#333333" }
    },
    {
      "name": "CSS value/function",
      "scope": ["support.constant.property-value", "support.function.css"],
      "settings": { "foreground": "#ab6526" }
    },
    {
      "name": "CSS at-rule",
      "scope": "keyword.control.at-rule",
      "settings": { "foreground": "#4b83cd", "fontStyle": "bold" }
    },
    {
      "name": "CSS number/unit",
      "scope": "constant.numeric.css",
      "settings": { "foreground": "#ab6526" }
    },
    {
      "name": "CSS selector",
      "scope": "entity.name.tag.css",
      "settings": { "foreground": "#4b83cd" }
    }
  ]
}
