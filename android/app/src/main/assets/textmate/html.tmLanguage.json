{
  "name": "HTML",
  "scopeName": "text.html.basic",
  "fileTypes": ["html", "htm", "xhtml"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#doctype" },
    { "include": "#tag" },
    { "include": "#entity" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.html" } },
      "end": "-->",
      "endCaptures": { "0": { "name": "punctuation.definition.comment.html" } }
    },
    "doctype": {
      "name": "meta.tag.sgml.doctype.html",
      "match": "(?i)<!DOCTYPE[^>]*>",
      "captures": { "0": { "name": "keyword.control.html" } }
    },
    "entity": {
      "name": "constant.character.entity.html",
      "match": "&(?:#x[0-9a-fA-F]+|#[0-9]+|[a-zA-Z][a-zA-Z0-9]*);?"
    },
    "tag": {
      "patterns": [
        { "include": "#tag-open" },
        { "include": "#tag-close" }
      ]
    },
    "tag-open": {
      "name": "meta.tag.html",
      "begin": "(<)((?:[a-z][a-z0-9]*|[A-Z][a-zA-Z0-9]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(/?>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.html" } },
      "patterns": [{ "include": "#attribute" }]
    },
    "tag-close": {
      "name": "meta.tag.html",
      "match": "(</)((?:[a-z][a-z0-9]*|[A-Z][a-zA-Z0-9]*))(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.html" }
      }
    },
    "attribute": {
      "patterns": [
        {
          "match": "([a-zA-Z_:\\-][a-zA-Z0-9_:\\-.]*)\\s*(=)\\s*",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" }
          }
        },
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#entity" }]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#entity" }]
        }
      ]
    }
  }
}
